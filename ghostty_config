# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
# font-family = Iosevka
# window-padding-x = 2
#
# # Spacing around the equals sign does not matter.
# # All of these are identical:
# key=value
# key= value
# key =value
# key = value
#
# # Any line beginning with a # is a comment. It's not possible to put
# # a comment after a config option, since it would be interpreted as a
# # part of the value. For example, this will have a value of "#123abc":
# background = #123abc
#
# # Empty values are used to reset config keys to default.
# key =
#
# # Some config options have unique syntaxes for their value,
# # which is explained in the docs for that config option.
# # Just for example:
# resize-overlay-duration = 4s 200ms
# --- Font Configuration ---
font-family = "JetBrainsMono NF SemiBold"
font-size = 15

# --- Window Aesthetics ---
window-padding-x = 12
window-padding-y = 12
background = #181825
foreground = #fbfbfb

# --- Pierre Palette ---

# Black/Dark Grey
palette = 0=#141415
palette = 8=#6c6c71

# Red
palette = 1=#ff2e3f
palette = 9=#ff6762

# Green
palette = 2=#0dbe4e
palette = 10=#5ecc71

# Yellow
palette = 3=#ffca00
palette = 11=#ffd452

# Blue (Lush Forest Green)
palette = 4=#009fff
palette = 12=#69b1ff

# Magenta
palette = 5=#c635e4
palette = 13=#d568ea

# Cyan
palette = 6=#08c0ef
palette = 14=#68cdf2

# White
palette = 7=#c6c6c8
palette = 15=#fbfbfb

# Shortcuts
keybind = f11=toggle_fullscreen
keybind = alt+up=goto_split:up
keybind = alt+down=goto_split:down
keybind = alt+right=goto_split:right
keybind = alt+left=goto_split:left

keybind = ctrl+shift+up=new_split:right
keybind = ctrl+shift+down=new_split:down
keybind = ctrl+shift+x=toggle_split_zoom

# Quick
shell-integration-features = ssh-env
shell-integration = zsh
quick-terminal-autohide = false
quick-terminal-size = 65%,80%
quick-terminal-screen = mouse
keybind = global:super+enter=toggle_quick_terminal
quit-after-last-window-closed = false
quick-terminal-animation-duration = 0

gtk-tabs-location = bottom
gtk-wide-tabs = false
adw-toolbar-style = raised
