"$schema" = 'https://starship.rs/config-schema.json'

# Added the rounded cap to the start of the second line
format = """
$os\
$username\
$directory\
$git_branch\
$c\
$rust\
$golang\
$nodejs\
$php\
$java\
$kotlin\
$haskell\
$python\
$conda\
$cmd_duration\
$line_break\
$character"""

palette = 'catppuccin_mocha'

[os]
disabled = false
style = "bg:red fg:crust"
format = "[](fg:red)[$symbol]($style)"

[os.symbols]
Windows = ""
Ubuntu = "󰕈"
SUSE = ""
Raspbian = "󰐿"
Mint = "󰣭"
Macos = "󰀵"
Manjaro = ""
Linux = "󰌽"
Gentoo = "󰣨"
Fedora = "󰣛"
Alpine = ""
Amazon = ""
Android = ""
AOSC = ""
Arch = "󰣇"
Artix = "󰣇"
CentOS = ""
Debian = "󰣚"
Redhat = "󱄛"
RedHatEnterprise = "󱄛"
Kali = " "

[username]
show_always = true
style_user = "bg:red fg:crust"
style_root = "bg:red fg:crust"
format = '[ $user]($style)[](fg:red)'

[directory]
style = "bg:peach fg:crust"
format = "[](fg:peach)[ $path ]($style)[](fg:peach)"
truncation_length = 3
truncation_symbol = "󱗘 "


[directory.substitutions]
"Documents" = "󰈙 "
"Downloads" = " "
"Music" = "󰝚 "
"Pictures" = " "
"Developer" = "󰲋 "

[git_branch]
symbol = ""
style = "bg:yellow fg:crust"
format = '[](fg:yellow)[ $symbol $branch ]($style)[](fg:yellow)'

# --- Programming Languages ---

[nodejs]
symbol = "󰎙 " 
style = "bg:green fg:crust"
format = '[](fg:green)[$symbol($version )]($style)[](fg:green)'

[rust]
symbol = " " 
style = "bg:green fg:crust"
format = '[](fg:green)[$symbol($version )]($style)[](fg:green)'

[golang]
symbol = "󰟓 " 
style = "bg:green fg:crust"
format = '[](fg:green)[$symbol($version )]($style)[](fg:green)'

[python]
symbol = "󱔎 " 
style = "bg:green fg:crust"
format = '[](fg:green)[$symbol($version )]($style)[](fg:green)'

[php]
symbol = "󰌟 "
style = "bg:green fg:crust"
format = '[](fg:green)[$symbol($version )]($style)[](fg:green)'

[java]
symbol = "󰬷 " 
style = "bg:green fg:crust"
format = '[](fg:green)[$symbol($version )]($style)[](fg:green)'

[kotlin]
symbol = "󱈙 " 
style = "bg:green fg:crust"
format = '[](fg:green)[$symbol($version )]($style)[](fg:green)'

[haskell]
symbol = "󰲒 " 
style = "bg:green fg:crust"
format = '[](fg:green)[$symbol($version )]($style)[](fg:green)'

[c]
symbol = "󰙨 " 
style = "bg:green fg:crust"
format = '[](fg:green)[$symbol($version )]($style)[](fg:green)'

# --- Environment & Utils ---
[conda]
symbol = "  "
style = "bg:sapphire fg:crust"
format = '[](fg:sapphire)[$symbol$environment ]($style)[](fg:sapphire)'

[cmd_duration]
style = "bg:lavender fg:crust"
format = "[](fg:lavender)[  $duration ]($style)[](fg:lavender)"

[line_break]
disabled = false

[character]
success_symbol = '[ ❯](bold fg:green)'
error_symbol = '[ ❯](bold fg:red)'

[sudo]
disabled = false
symbol = "󱆃 "
style = "bg:red fg:crust"
format = '[](fg:red)[$symbol]($style)[](fg:red)'

[docker_context]
symbol = " "
style = "bg:sapphire fg:crust"
format = '[](fg:sapphire)[$symbol $context]($style)[](fg:sapphire)'

[palettes.catppuccin_mocha]
red = "#f38ba8"
peach = "#fab387"
yellow = "#f9e2af"
green = "#a6e3a1"
sapphire = "#74c7ec"
lavender = "#b4befe"
crust = "#11111b"
white = "#cdd6f4"
